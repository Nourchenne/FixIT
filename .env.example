# Modèle de configuration FixIT — SANS secret, suivi par git.
# Copier ce fichier en .env (ignoré par git) et remplir les valeurs.
# Chaque membre du groupe utilise sa propre clé Groq, qui reste sur son PC.

# Clé API Groq — à créer sur https://console.groq.com
GROQ_API_KEY=remplacer_par_ta_cle

# Modèle Groq utilisé pour la génération des réponses du chat.
GROQ_MODEL=openai/gpt-oss-20b
